---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Heatmap from '@/components/Heatmap.astro';
import LanguageChart from '@/components/LanguageChart.astro';
import RepoGrid from '@/components/RepoGrid.astro';
import PostCard from '@/components/PostCard.astro';
import TermHero from '@/components/TermHero.astro';
import { getPublishedPosts } from '@/utils/posts';
import { withBase } from '@/utils/url';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero__grid">
      <TermHero />
    </div>
    <span class="hero__blob" aria-hidden="true"></span>
  </section>

  <section class="wrap block">
    <header class="block__head">
      <p class="eyebrow">Latest Writing</p>
      <a class="block__more" href={withBase('/posts')}>全部 {posts.length} 篇 →</a>
    </header>

    <div class="posts">
      {recent.map((post, i) => <PostCard post={post} featured={i === 0} />)}
    </div>
  </section>

  <section class="wrap block">
    <div class="gh">
      <Heatmap />
      <LanguageChart />
      <RepoGrid />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      175deg,
      color-mix(in srgb, var(--honey) 9%, transparent),
      transparent 55%
    );
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.4rem, 6vw, 4.5rem);
  }

  .hero__blob {
    position: absolute;
    top: -20%;
    right: -6%;
    width: 26rem;
    height: 26rem;
    border-radius: 100%;
    background-image: radial-gradient(
      color-mix(in srgb, var(--vermilion) 42%, transparent) 1.8px,
      transparent 1.9px
    );
    background-size: 10px 10px;
    mask-image: radial-gradient(circle at center, #000 30%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .block {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .block__head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .block__head .eyebrow {
    flex: 1;
  }

  .block__more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .block__more:hover {
    color: var(--accent);
  }

  .posts,
  .gh {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  @media (max-width: 720px) {
    .hero {
      border-bottom: none;
      background: none;
    }

    .hero__grid {
      padding-block: 0.9rem 0.15rem;
    }

    .hero__blob {
      display: none;
    }

    .block {
      padding-top: 1.7rem;
    }

    .block__head {
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.85rem;
    }

    .posts,
    .gh {
      gap: 0.65rem;
    }
  }
</style>
