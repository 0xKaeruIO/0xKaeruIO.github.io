---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getAdjacent, getPublishedPosts, getRelated } from '@/utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getPublishedPosts();
const { newer, older } = getAdjacent(posts, post.id);
const related = getRelated(posts, post);
---

<PostLayout post={post} headings={headings} newer={newer} older={older} related={related}>
  <Content />
</PostLayout>
