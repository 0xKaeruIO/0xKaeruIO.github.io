---
import { SITE } from '@/consts';
import { withBase } from '@/utils/url';
---

<article class="term card is-booting" data-term>
  <script is:inline>
    (() => {
      const el = document.currentScript && document.currentScript.parentElement;
      if (el && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.classList.remove('is-booting');
      }
    })();
  </script>
  <header class="term__bar" aria-hidden="true">
    <span class="term__dots">
      <i class="term__dot term__dot--close"></i>
      <i class="term__dot term__dot--min"></i>
      <i class="term__dot term__dot--max"></i>
    </span>
    <span class="term__title">{SITE.title}@hpc: ~</span>
  </header>

  <div class="term__body">
    <div class="term__pane">
      <p class="term__cmd" aria-hidden="true">
        <span class="term__prompt">$</span>
        <span data-type>cat /etc/motd</span>
      </p>
      <div class="term__out" data-out>
        <p class="eyebrow" data-type>HPC · Slurm · Systems</p>
        <h1 class="hero__title">
          <span class="misprint" data-type>折腾系统</span><br />
          <span class="hero__title-sub" data-type>也记录日常</span>
        </h1>
        <p class="hero__lead" data-type>
          这里存放我在高性能计算、集群调度和系统工程上踩过的坑，以及一些和工作无关的生活碎片。写给三个月后忘记细节的自己。
        </p>
      </div>
    </div>

    <div class="term__pane">
      <p class="term__cmd" aria-hidden="true">
        <span class="term__prompt">$</span>
        <span data-type>open posts/ about.md</span>
      </p>
      <div class="term__out hero__actions" data-out>
        <a class="btn" href={withBase('/posts')}>
          开始阅读
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.5 8h11m-4-4 4 4-4 4"
            />
          </svg>
        </a>
        <a class="btn btn--ghost" href={withBase('/about')}>关于我</a>
      </div>
      <p class="term__cmd term__cmd--live" data-live hidden>
        <span class="term__prompt">$</span>
        <span class="term__cursor"></span>
      </p>
    </div>
  </div>
</article>

<script>
  const root = document.querySelector<HTMLElement>('[data-term]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const typed = [...root.querySelectorAll<HTMLElement>('[data-type]')];
    const outputs = [...root.querySelectorAll<HTMLElement>('[data-out]')];
    const live = root.querySelector<HTMLElement>('[data-live]');
    const originals = typed.map((el) => el.textContent?.replace(/\s+/g, ' ').trim() ?? '');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let skipped = false;

    const finish = () => {
      skipped = true;
      typed.forEach((el, i) => {
        el.textContent = originals[i];
        el.classList.remove('is-typing');
        el.classList.add('is-done');
      });
      outputs.forEach((el) => el.classList.add('is-shown'));
      live?.removeAttribute('hidden');
      root.classList.remove('is-booting');
      root.classList.add('is-ready');
      root.removeAttribute('title');
      root.removeEventListener('click', onClick);
    };

    const onClick = (e: Event) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      finish();
    };

    if (reduce) {
      finish();
    } else {
      typed.forEach((el) => {
        el.textContent = '';
      });
      root.title = '点击窗口可跳过动画';
      root.addEventListener('click', onClick);

      const typeOne = async (el: HTMLElement, text: string, base = 36) => {
        el.classList.add('is-typing');
        for (let i = 1; i <= text.length; i++) {
          if (skipped) {
            el.classList.remove('is-typing');
            return;
          }
          el.textContent = text.slice(0, i);
          const ch = text[i - 1];
          const pause = /[，。、！？,.!/]/.test(ch) ? 90 : base + Math.random() * 22;
          await sleep(pause);
        }
        el.classList.remove('is-typing');
        el.classList.add('is-done');
        if (!skipped) await sleep(160);
      };

      (async () => {
        const [cmd1, motd, title, sub, lead, cmd2] = typed;
        await typeOne(cmd1, originals[0], 42);
        if (skipped) return;
        outputs[0]?.classList.add('is-shown');
        await sleep(120);
        await typeOne(motd, originals[1], 28);
        await typeOne(title, originals[2], 48);
        await typeOne(sub, originals[3], 40);
        await typeOne(lead, originals[4], 18);
        if (skipped) return;
        await sleep(220);
        await typeOne(cmd2, originals[5], 38);
        if (skipped) return;
        outputs[1]?.classList.add('is-shown');
        await sleep(200);
        if (skipped) return;
        live?.removeAttribute('hidden');
        root.classList.remove('is-booting');
        root.classList.add('is-ready');
        root.removeAttribute('title');
        root.removeEventListener('click', onClick);
      })();
    }
  }
</script>

<style>
  .term {
    --term-bg: #1f2a48;
    --term-fg: #faf3e2;
    --term-muted: #c4b9a0;
    --term-bar: color-mix(in srgb, #000 28%, var(--term-bg));
    overflow: hidden;
    background: var(--term-bg);
    border-color: color-mix(in srgb, var(--term-bg) 70%, var(--ink));
    box-shadow:
      4px 4px 0 0 color-mix(in srgb, var(--vermilion) 28%, transparent),
      8px 8px 0 0 color-mix(in srgb, var(--teal) 22%, transparent);
    color: var(--term-fg);
  }

  :global(:root[data-theme='dark']) .term {
    --term-bg: #12141c;
    --term-fg: #eee6d4;
    --term-muted: #a49b8a;
    --term-bar: #0c0d12;
    border-color: var(--sand);
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: var(--term-bar);
    border-bottom: 1px solid color-mix(in srgb, var(--term-fg) 12%, transparent);
  }

  .term__dots {
    display: flex;
    gap: 0.38rem;
    flex-shrink: 0;
  }

  .term__dot {
    width: 0.68rem;
    height: 0.68rem;
    border-radius: 100px;
  }

  .term__dot--close {
    background: var(--vermilion);
  }
  .term__dot--min {
    background: var(--honey);
  }
  .term__dot--max {
    background: var(--teal);
  }

  .term__title {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--term-fg) 62%, transparent);
    text-align: center;
    margin-right: 2.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    align-items: stretch;
    min-height: clamp(16rem, 32vw, 22rem);
    padding: 0;
  }

  .term__pane {
    display: flex;
    flex-direction: column;
    padding: 1.45rem 1.7rem 1.3rem;
    min-width: 0;
  }

  .term__pane + .term__pane {
    border-left: 1px dashed color-mix(in srgb, var(--term-fg) 16%, transparent);
    justify-content: flex-start;
  }

  .term__cmd {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--term-fg) 72%, transparent);
    min-height: 1.4em;
  }

  .term__prompt {
    color: var(--teal);
    font-weight: 500;
    flex-shrink: 0;
  }

  .term__cmd--live {
    margin-top: auto;
    padding-top: 1.4rem;
  }

  .term__cursor,
  [data-type].is-typing::after {
    display: inline-block;
    width: 0.55rem;
    height: 1em;
    margin-left: 0.12em;
    background: var(--honey);
    vertical-align: -0.12em;
    animation: term-blink 1.1s steps(1) infinite;
  }

  [data-type].is-typing::after {
    content: '';
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  .term.is-booting .term__cmd [data-type]:not(.is-typing):not(.is-done) {
    visibility: hidden;
  }

  .term.is-booting [data-out] {
    opacity: 0;
    transform: translateY(0.35rem);
    pointer-events: none;
  }

  .term.is-booting [data-out].is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 320ms ease, transform 320ms ease;
  }

  .term .eyebrow {
    display: block;
    margin: 0.85rem 0 0;
    color: var(--honey);
    letter-spacing: 0.14em;
    min-height: 1.2em;
  }

  .term .eyebrow::before,
  .term .eyebrow::after {
    content: none;
  }

  .hero__title {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    font-style: normal;
    font-variation-settings: normal;
    letter-spacing: 0.01em;
    line-height: 1.55;
    color: var(--term-fg);
  }

  .hero__title-sub {
    color: var(--term-muted);
    font-weight: 400;
    font-style: normal;
  }

  .hero__lead {
    max-width: 42ch;
    margin-top: 1.1rem;
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--term-muted);
    min-height: 5.2em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.85rem;
  }

  .hero__actions svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .term .btn {
    color: var(--term-fg);
    background: transparent;
    border-color: color-mix(in srgb, var(--term-fg) 38%, transparent);
  }

  .term .btn:hover {
    color: var(--accent-fg);
    background: var(--vermilion);
    border-color: var(--vermilion);
    box-shadow: 3px 3px 0 0 var(--teal);
  }

  .term .btn--ghost {
    color: var(--teal);
    border-color: color-mix(in srgb, var(--teal) 45%, transparent);
  }

  .term .btn--ghost:hover {
    color: var(--term-bg);
    background: var(--teal);
    border-color: var(--teal);
    box-shadow: 3px 3px 0 0 var(--honey);
  }

  @media (max-width: 800px) {
    .term__body {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .term__pane {
      padding: 1.2rem 1.2rem 1.1rem;
    }

    .term__pane + .term__pane {
      border-left: none;
      border-top: 1px dashed color-mix(in srgb, var(--term-fg) 16%, transparent);
      padding-top: 1.1rem;
    }

    .hero__lead {
      max-width: none;
      min-height: 0;
    }

    .term__cmd--live {
      padding-top: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term__cursor,
    [data-type].is-typing::after {
      animation: none;
      opacity: 0.7;
    }

    .term.is-booting [data-out],
    .term.is-booting [data-out].is-shown {
      opacity: 1;
      transform: none;
      transition: none;
      pointer-events: auto;
    }
  }
</style>
