---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '@/utils/format';
import { CATEGORY_LABELS } from '@/consts';
import { withBase } from '@/utils/url';

interface Props {
  post: CollectionEntry<'posts'>;
  /** 首页头条：更大的标题与更完整的摘要 */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, excerpt, pubDate, tags, category } = post.data;
const href = withBase(`/posts/${post.id}`);
const minutes = readingTime(post.body);
---

<article class:list={['post card card--lift']}>
  <a class="post__link" href={href} aria-labelledby={`t-${post.id}`}>
    <div class="post__side">
      <time class="post__date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span class="post__cat">{CATEGORY_LABELS[category] ?? category}</span>
    </div>

    <div class="post__main">
      <h3 class="post__title" id={`t-${post.id}`}>{title}</h3>
      <p class="post__desc">{excerpt ?? description}</p>

      <div class="post__foot">
        {tags.slice(0, featured ? 5 : 3).map((t) => <span class="tag">{t}</span>)}
        <span class="post__time meta">{minutes} 分钟</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
  }

  /* 左栏：日期与分类，像档案卡的索引条 */
  .post__side {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 1.15rem;
    border-right: 1px solid var(--border);
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .post__cat {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--vermilion);
    text-transform: uppercase;
  }

  .post__main {
    min-width: 0;
  }

  .post__title {
    font-size: var(--step-1);
    line-height: 1.32;
    transition: color var(--transition);
  }

  .post:hover .post__title {
    color: var(--vermilion);
  }

  .post__desc {
    margin-top: 0.55rem;
    font-size: 0.89rem;
    line-height: 1.72;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 0.85rem;
  }

  .post__time {
    margin-left: auto;
    font-size: 0.7rem;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .post__link {
      display: flex;
      flex-direction: column;
      gap: 0.28rem;
      padding: 0.9rem 1.05rem;
    }

    .post__side {
      flex-direction: row;
      align-items: baseline;
      gap: 0.55rem;
      padding: 0;
      border: none;
    }

    .post__title {
      font-size: 1.02rem;
      line-height: 1.4;
    }

    .post__desc {
      margin-top: 0.2rem;
      font-size: 0.84rem;
      line-height: 1.6;
    }

    .post__foot {
      margin-top: 0.5rem;
    }
  }
</style>
