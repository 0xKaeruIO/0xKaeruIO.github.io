---
import { github } from '@/utils/github';
import { formatCount } from '@/utils/format';
import { withBase } from '@/utils/url';

const { user, totals, contributions } = github;
const avatarSrc = user.avatarLocal ? withBase('/avatar.png') : user.avatarUrl;
const joined = new Date(user.createdAt).getFullYear();

const stats = [
  { label: 'Repos', value: formatCount(totals.repos) },
  { label: 'Stars', value: formatCount(totals.stars) },
  { label: 'Followers', value: formatCount(user.followers) },
  { label: 'Commits/yr', value: formatCount(contributions.total) },
];
---

<div class="profile card">
  <div class="portrait">
    <img
      src={avatarSrc}
      alt={`${user.name} 的 GitHub 头像`}
      width="128"
      height="128"
      loading="eager"
      decoding="async"
    />
    <span class="portrait__dots" aria-hidden="true"></span>
  </div>

  <div class="identity">
    <h2 class="name">{user.name}</h2>
    <a class="handle" href={user.htmlUrl} target="_blank" rel="noopener">@{user.login}</a>
    {user.bio && <p class="bio">{user.bio}</p>}
    <p class="meta since">自 {joined} 年起在 GitHub 上写代码</p>
  </div>

  <dl class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .profile {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'portrait identity'
      'stats stats';
    gap: 1.25rem 1.4rem;
    padding: 1.5rem;
  }

  /* 头像：红色描边 + 复古硬阴影 + 网点装饰角 */
  .portrait {
    grid-area: portrait;
    position: relative;
    width: 5.4rem;
    height: 5.4rem;
  }

  .portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 100px;
    border: 2px solid var(--vermilion);
    background: var(--bg-sunken);
    box-shadow: 4px 4px 0 0 color-mix(in srgb, var(--ink) 88%, transparent);
  }

  /* 青色网点角标：压在头像下方，露出一角，模拟套色偏移 */
  .portrait__dots {
    position: absolute;
    right: -0.7rem;
    top: -0.5rem;
    z-index: 0;
    width: 2.4rem;
    height: 2.4rem;
    background-image: radial-gradient(var(--teal) 1.3px, transparent 1.4px);
    background-size: 6px 6px;
    opacity: 0.85;
  }

  .identity {
    grid-area: identity;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .name {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .handle {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--teal);
    text-decoration: none;
    width: fit-content;
  }

  .handle:hover {
    color: var(--vermilion);
  }

  .bio {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--fg-muted);
    padding-left: 0.7rem;
    border-left: 2px solid var(--honey);
  }

  .since {
    margin-top: 0.5rem;
  }

  /* 统计数字：档案卡片式的分栏 */
  .stats {
    grid-area: stats;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-inline: 0.75rem;
    border-left: 1px solid var(--border);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: none;
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .profile {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'portrait identity'
        'stats stats';
      gap: 0.7rem 0.9rem;
      padding: 1rem 1.05rem;
    }

    .portrait {
      width: 3.55rem;
      height: 3.55rem;
    }

    .portrait img {
      box-shadow: 3px 3px 0 0 color-mix(in srgb, var(--ink) 82%, transparent);
    }

    .portrait__dots {
      right: -0.4rem;
      top: -0.35rem;
      width: 1.55rem;
      height: 1.55rem;
    }

    .name {
      font-size: var(--step-1);
    }

    .bio {
      margin-top: 0.3rem;
      font-size: 0.74rem;
      line-height: 1.5;
      padding-left: 0.5rem;
    }

    .since {
      margin-top: 0.25rem;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.55rem 0;
      padding-top: 0.7rem;
    }

    .stat {
      padding-inline: 0.45rem;
    }

    .stat:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }

    .stat dd {
      font-size: 1.05rem;
    }
  }
</style>
