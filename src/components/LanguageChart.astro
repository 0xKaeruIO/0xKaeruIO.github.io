---
import { LANGUAGES } from '@/consts';

type Lang = (typeof LANGUAGES)[number];

const rotate = (items: readonly Lang[], offset: number) =>
  items.slice(offset).concat(items.slice(0, offset));

/** 三行错开起点和速度，看起来是铺满一整块，而不是同一列在齐步走。 */
const rows = [
  { items: rotate(LANGUAGES, 0), duration: '42s', delay: '0s' },
  { items: rotate(LANGUAGES, 3), duration: '56s', delay: '-18s' },
  { items: rotate(LANGUAGES, 6), duration: '48s', delay: '-8s' },
];
---

<section class="langs card" aria-labelledby="langs-title">
  <p class="eyebrow" id="langs-title">MEMORY</p>


  <div class="marquee" aria-hidden="true">
    {
      rows.map((row) => (
        <div class="track">
          <div class="strip" style={`--dur:${row.duration};--delay:${row.delay}`}>
            {[0, 1].map(() =>
              row.items.map((lang) => (
                <span class="chip">
                  <span class="chip__name">{lang.name}</span>
                  <span class="chip__code">{lang.snippet}</span>
                </span>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .langs {
    padding: 1.4rem 0 1.25rem;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }

  .langs :global(.eyebrow) {
    padding-inline: 1.5rem;
  }

  .marquee {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.15rem;
    min-width: 0;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 1.5rem,
      #000 calc(100% - 1.5rem),
      transparent
    );
  }

  .track {
    overflow: hidden;
    min-width: 0;
    width: 100%;
  }

  /* 内容复制两份，动画位移 50% 时无缝接上 */
  .strip {
    display: flex;
    width: max-content;
    gap: 0.55rem;
    padding-inline: 0.55rem;
    animation: marquee var(--dur) linear var(--delay) infinite;
  }

  .track:hover .strip {
    animation-play-state: paused;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-shrink: 0;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: var(--bg-elevated);
    white-space: nowrap;
    box-shadow: 2px 2px 0 0 color-mix(in srgb, var(--shadow-hard) 7%, transparent);
  }

  .chip__name {
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .chip__code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--vermilion-deep);
    opacity: 0.88;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }

    .marquee {
      mask-image: none;
      padding-inline: 1.15rem;
    }
  }

  @media (max-width: 720px) {
    .langs {
      display: none;
    }
  }
</style>
